# ============================================
# PBL 科创育人平台 - 后端环境变量示例
# 复制为 .env 后按需修改
# ============================================

# 服务端口
PORT=3000

# 服务监听地址（生产必须 127.0.0.1，由 Nginx 反向代理对外提供服务）
HOST=127.0.0.1

# API 路径前缀
API_PREFIX=/api

# JWT 签名密钥（生产环境【必须】显式设置；不设置时生产环境将直接启动失败，开发/测试环境才会自动生成到 backend/.jwt-secret）
# 生成示例：openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_string

# 允许跨域的前端地址（开发时为 Vite 地址）
CORS_ORIGIN=http://localhost:5173

# 上传文件根目录（相对 backend 目录；生产建议用绝对路径指向持久化数据盘，如 /datadisk/pbl-platform/uploads）
UPLOAD_PATH=./uploads

# 反馈附件根目录（可选；生产建议用绝对路径指向持久化数据盘，如 /datadisk/pbl-platform/private_uploads/feedback）
# FEEDBACK_UPLOAD_PATH=

# SQLite 数据库路径（相对 backend 目录；自动化测试会覆盖为临时数据库）
DB_PATH=./database/pbl_platform.db

# 运行环境：development / production
NODE_ENV=development

# ========== 正式环境初始化（npm run db:provision） ==========
# 首次上线使用：建表（含幂等迁移）+ 创建初始管理员；不会删除数据、不写入测试账号。
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=<至少12位强密码>
# ADMIN_REAL_NAME=系统管理员

# ========== 登录安全 ==========
# IP 级登录限流（次数/分钟）
LOGIN_RATE_LIMIT_IP=10
# 用户名级登录限流（失败次数/分钟）
LOGIN_RATE_LIMIT_USER=5
# 账户锁定阈值（连续失败次数）
ACCOUNT_LOCK_THRESHOLD=10
# 账户锁定持续时间（分钟）
ACCOUNT_LOCK_DURATION=15

# ========== JWT 配置（若修改了有效期） ==========
# Access Token 有效期（分钟），建议 15-30
JWT_ACCESS_EXPIRES_IN=15
# Refresh Token 有效期（天），建议 7-30
JWT_REFRESH_EXPIRES_IN=7

# ========== 滑翔机模拟引擎（学生科创功能） ==========
# Node 后端通过子进程调用 test_Novaphy/glider_sim/sim_service.py 运行物理仿真。
# novaPhy wheel 仅支持 Linux x86_64 + CPython 3.11，解释器按环境配置：
#   服务器(Linux)      ：GLIDER_PYTHON=/opt/novaphy/bin/python              （原生调用，真 novaPhy）
#   本地(Windows+WSL)  ：GLIDER_PYTHON=wsl:Ubuntu-24.04:/opt/novaphy/bin/python  （经 wsl.exe 调 novaPhy）
#   本地无 WSL 兜底     ：GLIDER_PYTHON=python 且 GLIDER_BACKEND=reference  （纯 numpy，行为等价）
# GLIDER_BACKEND auto（默认，可加载 novaPhy 则优先）/ novaphy / reference
# GLIDER_MAX_ACTIVE 同时运行的模拟任务上限（默认 2）
# GLIDER_TIMEOUT  单次最长仿真时间秒数（默认 100；150m 投放稳定滑翔约 65~75s 才落地）
# MP4 飞行回放（默认生成，固定机位覆盖全程；依赖 Python 环境已装 imageio-ffmpeg；缺失时自动跳过不报错）：
# GLIDER_VIDEO=1       # 0=关闭
# GLIDER_VIDEO_FPS=10  # 回放帧率（全程固定机位建议 8~10 平衡时长与流畅度）
# GLIDER_VIDEO_MAX=300 # 回放时长上限(秒)，默认 300=不截断、覆盖整段飞行含着陆
# GLIDER_PYTHON=
# GLIDER_BACKEND=auto
