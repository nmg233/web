# ============================================
# PBL 科创育人平台 - 后端环境变量示例
# 复制为 .env 后按需修改
# ============================================

# 服务端口
PORT=3000

# API 路径前缀
API_PREFIX=/api

# JWT 签名密钥（生产环境【必须】显式设置；不设置时生产环境将直接启动失败，开发/测试环境才会自动生成到 backend/.jwt-secret）
# 生成示例：openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_string

# 允许跨域的前端地址（开发时为 Vite 地址）
CORS_ORIGIN=http://localhost:5173

# 上传文件根目录（相对 backend 目录）
UPLOAD_PATH=./uploads

# SQLite 数据库路径（相对 backend 目录；自动化测试会覆盖为临时数据库）
DB_PATH=./database/pbl_platform.db

# 运行环境：development / production
NODE_ENV=development

# ========== 注册 ==========
# 是否开放学生自助注册（true 开启，默认关闭；关闭时注册接口返回 403）
ALLOW_REGISTRATION=false
# 注册接口 IP 级限流（次数/分钟）
REGISTER_RATE_LIMIT=5

# ========== 登录安全 ==========
# IP 级登录限流（次数/分钟）
LOGIN_RATE_LIMIT_IP=10
# 用户名级登录限流（失败次数/分钟）
LOGIN_RATE_LIMIT_USER=5
# 账户锁定阈值（连续失败次数）
ACCOUNT_LOCK_THRESHOLD=10
# 账户锁定持续时间（分钟）
ACCOUNT_LOCK_DURATION=15

# ========== JWT 配置（若修改了有效期） ==========
# Access Token 有效期（分钟），建议 15-30
JWT_ACCESS_EXPIRES_IN=15
# Refresh Token 有效期（天），建议 7-30
JWT_REFRESH_EXPIRES_IN=7
