    },
    "mentor.Guide.ba7f24c5ef91": {
      "text": "办课使用指引",
      "page": "mentor/Guide",
      "source": "frontend/src/pages/mentor/Guide.jsx"
    },
    "mentor.Guide.950468c240bf": {
      "text": "学校管理、课程管理、学生报名和教师观察分别授权；有学校不等于已报名课程",
      "page": "mentor/Guide",
      "source": "frontend/src/pages/mentor/Guide.jsx"
    },
    "mentor.Guide.187eed5ac9dc": {
      "text": "从首次登录到学生学习",
      "page": "mentor/Guide",
      "source": "frontend/src/pages/mentor/Guide.jsx"
    },
    "mentor.Guide.050ab8a9c6fd": {
      "text": "首次改密，保护账号与初始凭据；凭据私下交给本人，不放入通知或教材。",
      "page": "mentor/Guide",
      "source": "frontend/src/pages/mentor/Guide.jsx"
    },
    "mentor.Guide.b901d267b3a1": {
      "text": "学校与账号：说明办学背景并申请学校，管理员批准后才能在本校建班和建号。没有学校仍可准备课程草稿。",
      "page": "mentor/Guide",
      "source": "frontend/src/pages/mentor/Guide.jsx"
    },
    "mentor.Guide.16a1c6d5a153": {
      "text": "新建班级、学生或教师；账号已建立不等于加入课程。教师还须明确选择学生与课程观察范围。",
      "page": "mentor/Guide",
      "source": "frontend/src/pages/mentor/Guide.jsx"
    },
    "mentor.Guide.246609b072fc": {
      "text": "新建课程后先查看概览和填写清单。课程的上线学校需明确选择，默认不勾选全部学校。",
      "page": "mentor/Guide",
      "source": "frontend/src/pages/mentor/Guide.jsx"
    },
    "mentor.Guide.cabaf6a4d6c8": {
      "text": "课时与内容：选择教学课时模板，填写教材、卡片和练习。空选填字段在学生端隐藏。",
      "page": "mentor/Guide",
      "source": "frontend/src/pages/mentor/Guide.jsx"
    },
    "mentor.Guide.c15378c65254": {
      "text": "上传只是文件保存；正文中选择引用并保存后才成为教学内容。上传失败可保留队列重试。",
      "page": "mentor/Guide",
      "source": "frontend/src/pages/mentor/Guide.jsx"
    },
    "mentor.Guide.a56e61f3a5aa": {
      "text": "受控学生预览检查内容；课程发布、课时就绪、卡片发布是独立状态。学生开始后使用教材快照，不能覆盖其历史版本。",
      "page": "mentor/Guide",
      "source": "frontend/src/pages/mentor/Guide.jsx"
    },
    "mentor.Guide.af85bdc58bae": {
      "text": "课程发布后，从学员与授权报名本范围学生；学生没有自助选课入口。",
      "page": "mentor/Guide",
      "source": "frontend/src/pages/mentor/Guide.jsx"
    },
    "mentor.Guide.f92bbb53de08": {
      "text": "教学与成长：处理报告及作品评审，按原评分与金币规则结算；课程奖励中处理既有兑换发放。",
      "page": "mentor/Guide",
      "source": "frontend/src/pages/mentor/Guide.jsx"
    },
    "mentor.Guide.938f83b07a98": {
      "text": "发生保存冲突先保留输入，核对最新修订后再保存；撤权后停止写入并联系管理员。",
      "page": "mentor/Guide",
      "source": "frontend/src/pages/mentor/Guide.jsx"
    },
    "mentor.Guide.3fbc4beb3ad7": {
      "text": "原有工具与兼容入口",
      "page": "mentor/Guide",
      "source": "frontend/src/pages/mentor/Guide.jsx"
    },
    "mentor.Guide.b4d79dbaebef": {
      "text": "课程管理",
      "page": "mentor/Guide",
      "source": "frontend/src/pages/mentor/Guide.jsx"
    },
    "mentor.Guide.3d6a1679784d": {
      "text": "教学与成长",
      "page": "mentor/Guide",
      "source": "frontend/src/pages/mentor/Guide.jsx"
    },
    "mentor.Guide.449e1339ffe7": {
      "text": "课程学生与记录",
      "page": "mentor/Guide",
      "source": "frontend/src/pages/mentor/Guide.jsx"
    },
    "mentor.Guide.29bee1ad89b4": {
      "text": "平台问题反馈",
      "page": "mentor/Guide",
      "source": "frontend/src/pages/mentor/Guide.jsx"
    },
    "mentor.Guide.c6e74a4ec129": {
      "text": "规则学习助手（以启用状态为准）",
      "page": "mentor/Guide",
      "source": "frontend/src/pages/mentor/Guide.jsx"
    },
    "mentor.Guide.fd3bdcd21b3f": {
      "text": "独立实验工具",
      "page": "mentor/Guide",
      "source": "frontend/src/pages/mentor/Guide.jsx"
    },
    "mentor.Guide.f88182fcd575": {
      "text": "进入",
      "page": "mentor/Guide",
      "source": "frontend/src/pages/mentor/Guide.jsx"
    },
    "mentor.Guide.28c834ddacb1": {
      "text": "数据课程包和高级开发指引将随第三步提供；当前不开放任意脚本或交互代码运行。",
      "page": "mentor/Guide",
      "source": "frontend/src/pages/mentor/Guide.jsx"
    },
    "courses.SchoolScope.0d359599dc98": {
